# Servidor local. El host está fijado por código a 127.0.0.1.
PORT=4310
DATA_DIR=./data

# Proveedores opcionales. No añadas claves reales a este archivo.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=

# Investigación de mercado multi-fuente (servidor). Sin clave, el proveedor
# aparece como "No configurado" y Demo / Texto manual / YouTube siguen activos.
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
FIRECRAWL_API_KEY=

# Análisis semántico: DeepSeek deepseek-v4-flash es primario, Gemini es respaldo.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GEMINI_API_KEY=

# Modelos OpenAI opcionales. También se pueden configurar por proyecto en la UI.
OPENAI_ECONOMY_MODEL=
OPENAI_POWERFUL_MODEL=
